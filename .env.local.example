NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor: nunca use o prefixo NEXT_PUBLIC_ nem importe em Client Components.
SUPABASE_SERVICE_ROLE_KEY=

# Login pelo Telegram. O token é o do bot Carcará (segredo, só no servidor);
# o username é sem @ e aparece no widget.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Login pelo Telegram (OpenID Connect, fluxo atual). No BotFather: abra o mini app
# (t.me/botfather?startapp) > seu bot > Login Widget; o Client ID é o id numérico do
# bot (já deduzido do token) e o Client Secret aparece lá. Em "Allowed URLs" cadastre
# a origem do site e a URL de retorno https://SEU-DOMINIO/auth/telegram/callback.
TELEGRAM_CLIENT_SECRET=
# Opcional: só se o Client ID for diferente do prefixo do token.
# TELEGRAM_CLIENT_ID=
